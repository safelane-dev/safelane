# safelane-demo-api — the demo application. It owns its Rollout, both
# Services, and the background AnalysisTemplate the Rollout references.
# SafeLane reads all four and patches two fields of one of them.
NAMESPACE=safelane-demo-api
ROLLOUT=safelane-demo-api
ANALYSIS_TEMPLATE=success-rate
STABLE_SERVICE=safelane-demo-api-stable
CANARY_SERVICE=safelane-demo-api-canary
BASELINE_TAG="sha-b41e90270fd052820c24c4f255a931044e32d6cb"
BASELINE_IMAGE_REPO="ghcr.io/safelane-dev/safelane-demo-api"
BASELINE_DIGEST="sha256:d6256dd1031636945b9f773811cc556d55a264c8913d814b7172f5b499f3e831"
# No ingress: weights are approximated by replica count for this app.
LOADGEN_MODE=service
LOADGEN_HOST=
